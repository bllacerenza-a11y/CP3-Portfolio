# A home/GitHub roda sem variáveis. Auth/dados T04/T05 usam estes valores públicos:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Só servidor/Function. Nunca usar prefixo VITE_ nem colocar em código/screenshots.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Gere pelo menos 32 caracteres aleatórios; troca reinicia buckets de IP.
CONTACT_RATE_LIMIT_SECRET=
# Origens exatas separadas por vírgula, sem barra final. Acrescente preview explicitamente.
CONTACT_ALLOWED_ORIGINS=

# Opcionais: deixe AUSENTES até configurar. Sem e-mail, contato persiste com falha parcial.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=
# CONTACT_TO_EMAIL=

# Proprietário é configurado no banco (supabase/provisionOwner.example.sql), por UUID Auth.
# Não existe CONTACT_OWNER_ID no cliente/servidor e não há cadastro público na aplicação.
