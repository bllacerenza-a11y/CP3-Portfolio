{
  "name": "cp3-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:auth-check": "node scripts/createAuthProbe.mjs && vite --host 127.0.0.1 --port 4176 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"{src,shared,server,api,tests}/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"*.{js,ts,json,html}\" \".github/**/*.yml\" .prettierrc.json",
    "format:check": "prettier --check \"{src,shared,server,api,tests}/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"*.{js,ts,json,html}\" \".github/**/*.yml\" .prettierrc.json",
    "test": "npm run test:server && npm run build && playwright test",
    "test:server": "playwright test --config playwright.server.config.ts",
    "test:supabase": "node --env-file=.env scripts/verifySupabase.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.4.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
